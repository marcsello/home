#!/bin/bash

set -e
set -u

# target url scheme:
#https://github.com/{org}/{repo}

if ! git rev-parse --is-inside-work-tree >/dev/null; then
	echo "Not in git repository"
	exit 1
fi

# figure out url

origin_url=$(git config --get remote.origin.url)
if grep -q '^git@' <<< "${origin_url}"; then

	org_repo=$(cut -d ':' -f 2 <<< "${origin_url}" | sed 's/\.git$//g')
	url="https://github.com/${org_repo}"

else

	url=$(sed 's/\.git$//g' <<< "${origin_url}")

fi

# figure out if we are not on the main branch
current_branch=$(git rev-parse --abbrev-ref HEAD)
default_branch=$(git rev-parse --abbrev-ref refs/remotes/origin/HEAD | cut -d '/' -f 2)

if [[ "${current_branch}" != "${default_branch}" ]]; then
	url="${url}/tree/${current_branch}"
fi

echo "Open GitHub for ${url}"
xdg-open "${url}"